# Copy this file to `.env.local` and fill in the values you need.
# `.env.local` (and `.env`) are gitignored; never commit real secrets.

# ---------------------------------------------------------------------------
# AI provider (server-side only, used by src/app/api/insights+api.ts).
# Do NOT prefix these with EXPO_PUBLIC_ — that would inline them into the
# client bundle and expose the key in the shipped app.
#
# Set a key for ONE provider. The provider is auto-detected from whichever key
# is present (order: groq, gemini, openai, anthropic), or pick one explicitly
# with INSIGHTS_PROVIDER.
# ---------------------------------------------------------------------------

# Recommended free option. Free tier, and Groq does not retain/train on your
# data by default. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Alternative free option (Google AI Studio). Note: the free tier may use your
# data to improve Google products. Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Paid options.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional overrides:
# INSIGHTS_PROVIDER=groq          # groq | gemini | openai | anthropic
# INSIGHTS_MODEL=                 # override the model (see README for defaults)
# INSIGHTS_BASE_URL=              # override the base URL (e.g. a local Ollama at
#                                 # http://192.168.1.50:11434/v1 — no key needed)

# ---------------------------------------------------------------------------
# Client-side (inlined into the app bundle — never put secrets here).
# ---------------------------------------------------------------------------

# Absolute URL of the insights endpoint. Required for release native builds
# so the app knows where to send notes. On web / local dev the relative
# `/api/insights` route is used automatically and this can stay unset.
# EXPO_PUBLIC_INSIGHTS_API_URL=https://your-server.example.com/api/insights
